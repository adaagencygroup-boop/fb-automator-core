  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["fb", "python", "fastapi", "nextjs", "loki", "prometheus", "grafana", "system", "ram", "storage"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["1s", "5s", "10s", "30s", "1m", "5m"]
