    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 34 },
      "id": 19,
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "title": "Live Application Log Stream",
      "type": "logs",
      "targets": [
        {
          "expr": "{container=~\"app|admin|postgres|redis|nginx|node\"}",
          "refId": "A"
        }
      ]
    }
