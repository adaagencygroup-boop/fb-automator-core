# =====================================================================
# FACEBOOK AUTOMATOR PRO - TEMPLATE CẤU HÌNH (.env.example)
# Sao chép thành .env rồi điền secret. Không commit .env.
# =====================================================================

# 1. Cơ sở dữ liệu (Supabase PostgreSQL / Cloud Postgres)
DATABASE_URL=postgresql://postgres.jnjvyvgvutdjozcljhiv:fb-automator-core@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# 2. Local Engine Server (FastAPI Sidecar)
ENGINE_HOST=127.0.0.1
ENGINE_PORT=28129

# 3. Frontend Next.js Public URLs
NEXT_PUBLIC_API_URL=http://127.0.0.1:28129
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:28129/ws/logs

# 4. Trí tuệ nhân tạo Google Gemini API (phân cách bằng dấu phẩy nếu có nhiều key để xoay tua)
GEMINI_API_KEYS=

# 5. Cấu hình Meta Graph API
FACEBOOK_GRAPH_API_VERSION=v19.0

# 6. Super admin. Đổi mật khẩu và JWT_SECRET trước khi đưa ra ngoài máy này.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
JWT_SECRET=change-me-in-production-fb-automator

# 7. Supabase Storage — video Module 5. Bucket private page-videos.
# service_role lấy ở Dashboard → Project Settings → API Keys. Không commit key thật.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=page-videos
