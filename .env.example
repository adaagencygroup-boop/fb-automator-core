# =====================================================================
# FACEBOOK AUTOMATOR PRO - TEMPLATE CẤU HÌNH (.env.example)
# Hướng dẫn: Sao chép file này thành .env và điền các thông tin bảo mật:
# Windows (cmd/pwsh): copy .env.example .env
# Linux / macOS:      cp .env.example .env
# =====================================================================

# 1. Cơ sở dữ liệu (Supabase PostgreSQL / Cloud Postgres)
# Định dạng: postgresql://<user>.<project_ref>:<password>@<host>:<port>/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.jnjvyvgvutdjozcljhiv:fb-automator-core@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# 2. Local Engine Server (FastAPI Sidecar)
ENGINE_HOST=127.0.0.1
ENGINE_PORT=28129

# 3. Frontend Next.js Public URLs
NEXT_PUBLIC_API_URL=http://127.0.0.1:28129
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:28129/ws/logs

# 4. Trí tuệ nhân tạo Google Gemini API (phân cách bằng dấu phẩy nếu nhiều key để xoay tua chống hạn ngạch)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# 5. Cấu hình Meta Graph API
FACEBOOK_GRAPH_API_VERSION=v19.0

# 6. Super admin bản quyền (cùng vai trò admin của project_auto_create_page_facebook)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
JWT_SECRET=change-me-in-production-fb-automator
