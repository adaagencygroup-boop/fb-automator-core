# Nginx chỉ đưa 3 tên miền vào trong Docker.
# admin  -> Next.js admin
# api    -> local_engine (API, không mở Chrome)
# pgadmin -> xem PostgreSQL
# Cổng 5432 không đi qua Nginx. File .exe trên máy người dùng nối thẳng Postgres.

server {
    listen 80;
    server_name ${ADMIN_HOST};

    client_max_body_size 30m;

    location / {
        proxy_pass http://admin:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name ${API_HOST};

    client_max_body_size 50m;

    location / {
        proxy_pass http://engine:28129;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}

server {
    listen 80;
    server_name ${PGADMIN_HOST};

    client_max_body_size 30m;

    location / {
        proxy_pass http://pgadmin:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_redirect off;
    }
}
