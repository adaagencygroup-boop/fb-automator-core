# Sao chép thành deploy/.env rồi sửa. Không commit file .env.

# Tên miền trỏ A record về IP VPS. Nginx nhận theo tên này.
ADMIN_HOST=admin.example.com
API_HOST=api.example.com
PGADMIN_HOST=pgadmin.example.com
HTTP_PORT=80

# URL trình duyệt của admin dùng để gọi API. Đổi sang https thì build lại image admin.
PUBLIC_API_URL=http://api.example.com
CORS_ORIGINS=http://admin.example.com

# PostgreSQL. File .exe dùng cùng user/password/db, nhưng host là IP công khai của VPS.
POSTGRES_USER=fbautomator
POSTGRES_PASSWORD=doi-mat-khau-manh
POSTGRES_DB=fb_automator
POSTGRES_PORT=5432
POSTGRES_BIND=0.0.0.0

# pgAdmin — http://PGADMIN_HOST
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=doi-mat-khau-pgadmin

# Tài khoản admin tạo lúc engine khởi động.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-admin
JWT_SECRET=doi-chuoi-bi-mat-dai
