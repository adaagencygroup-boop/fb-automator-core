Project module_07_group_spam {
  database_type: "PostgreSQL"
  Note: '''
    Module 7 uses PostgreSQL/Supabase only.
    Legacy SQLite is imported once by migration 006 and is not used at runtime.
  '''
}

Enum group_action_type {
  POST
  COMMENT
}

Enum group_run_status {
  QUEUED
  SCHEDULED
  RUNNING
  STOPPING
  COMPLETED
  PARTIAL
  STOPPED
  CANCELLED
  FAILED
}

Enum group_log_status {
  SUCCESS
  PENDING_APPROVAL
  FAILED
  SKIPPED
  CANCELLED
}

Enum group_event_level {
  INFO
  SUCCESS
  WARNING
  ERROR
}

Table cloud_group_campaigns {
  campaign_id varchar(36) [pk, not null]
  owner_key varchar(100) [not null, note: "Owner scope used to isolate user data"]
  name varchar(200) [not null]
  description text
  action_type group_action_type [not null]
  deleted_at timestamp [note: "Soft-delete timestamp; NULL means active"]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP AT TIME ZONE 'UTC'`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP AT TIME ZONE 'UTC'`]

  indexes {
    (owner_key, created_at) [name: "idx_cloud_group_campaigns_owner_created"]
    (owner_key, action_type, deleted_at) [name: "idx_cloud_group_campaigns_owner_type"]
    (owner_key, name) [name: "idx_cloud_group_campaigns_owner_name"]
  }

  Note: "Campaign metadata, soft-delete state and rerun ownership."
}

Table cloud_group_runs {
  run_id varchar(36) [pk, not null]
  campaign_id varchar(36) [not null]
  run_number integer [not null, default: 1, note: "Sequential within a campaign; must be >= 1"]
  owner_key varchar(100) [not null]
  campaign_name varchar(200) [not null, note: "Name snapshot at execution time"]
  action_type group_action_type [not null]
  config_json jsonb [not null, default: `{}`, note: "Sanitized configuration used by Retry/Rerun"]
  status group_run_status [not null]
  total_planned integer [not null, default: 0]
  total_success integer [not null, default: 0]
  total_failed integer [not null, default: 0]
  total_skipped integer [not null, default: 0]
  started_at timestamp
  finished_at timestamp
  synced_at timestamp [not null, default: `CURRENT_TIMESTAMP AT TIME ZONE 'UTC'`]

  indexes {
    (campaign_id, run_number) [unique, name: "uq_cloud_group_runs_campaign_number"]
    (owner_key, finished_at) [name: "idx_cloud_group_runs_history"]
    (owner_key, status, finished_at) [name: "idx_cloud_group_runs_status"]
    (owner_key, action_type, finished_at) [name: "idx_cloud_group_runs_type"]
  }

  Note: "Live and final run summary. Aggregate totals are non-negative and cannot exceed total_planned."
}

Table cloud_group_events {
  event_id varchar(36) [pk, not null]
  run_id varchar(36) [not null]
  owner_key varchar(100) [not null]
  sequence_number integer [not null, note: "Monotonic within a run; must be >= 1"]
  level group_event_level [not null]
  message text [not null]
  created_at timestamp [not null]
  synced_at timestamp [not null, default: `CURRENT_TIMESTAMP AT TIME ZONE 'UTC'`]

  indexes {
    (run_id, sequence_number) [unique, name: "uq_cloud_group_events_sequence"]
    (run_id, sequence_number) [name: "idx_cloud_group_events_run_sequence"]
    (owner_key, created_at) [name: "idx_cloud_group_events_owner_created"]
  }

  Note: "Progress messages written directly while a campaign is running."
}

Table cloud_group_logs {
  log_id varchar(36) [pk, not null]
  run_id varchar(36) [not null]
  owner_key varchar(100) [not null]
  action_type group_action_type [not null]
  account_uid varchar(50) [not null, note: "Logical reference to the Module 2 Facebook account UID"]
  account_name varchar(150)
  group_key varchar(255) [not null]
  group_name varchar(255)
  group_url text [not null]
  content text
  status group_log_status [not null]
  result_message text
  error_code varchar(100)
  error_detail text
  result_url text
  finished_at timestamp [not null]
  synced_at timestamp [not null, default: `CURRENT_TIMESTAMP AT TIME ZONE 'UTC'`]

  indexes {
    (run_id, status) [name: "idx_cloud_group_logs_run_status"]
    (owner_key, finished_at) [name: "idx_cloud_group_logs_history"]
    (owner_key, account_uid, finished_at) [name: "idx_cloud_group_logs_account"]
    (owner_key, group_key, finished_at) [name: "idx_cloud_group_logs_group"]
  }

  Note: "Final outcome for each account/group action."
}

Ref fk_cloud_group_runs_campaign {
  cloud_group_campaigns.campaign_id < cloud_group_runs.campaign_id [delete: cascade]
}

Ref fk_cloud_group_events_run {
  cloud_group_runs.run_id < cloud_group_events.run_id [delete: cascade]
}

Ref fk_cloud_group_logs_run {
  cloud_group_runs.run_id < cloud_group_logs.run_id [delete: cascade]
}
