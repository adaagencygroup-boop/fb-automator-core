      "roundness": null,
      "seed": 1557228455,
      "version": 3,
      "versionNonce": 1832567260,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791641447005,
      "link": null,
      "locked": false,
      "text": "POST /api/seeding/targets/resolve\n     { type: PAGE|PROFILE|POST, links: string[] }\n  -> { targets: Target[], invalid: [], duplicates: [] }\n\nPOST /api/seeding/targets/import   (.xlsx/.xls/.csv, <= 10MB)\n  -> { rows: [{ link, note }], invalid: [] }\nGET  /api/seeding/targets/import/template   -> file mẫu .xlsx\n\nGET  /api/seeding/accounts/summary\n  -> { total: 120, live: 115, available: 112 }\n\nPOST /api/seeding/preview          (xem trước phân bổ)\n     { type, targets, accountCount, actions, reactions }\n  -> { split: [{ targetId, action, count }] }",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST /api/seeding/targets/resolve\n     { type: PAGE|PROFILE|POST, links: string[] }\n  -> { targets: Target[], invalid: [], duplicates: [] }\n\nPOST /api/seeding/targets/import   (.xlsx/.xls/.csv, <= 10MB)\n  -> { rows: [{ link, note }], invalid: [] }\nGET  /api/seeding/targets/import/template   -> file mẫu .xlsx\n\nGET  /api/seeding/accounts/summary\n  -> { total: 120, live: 115, available: 112 }\n\nPOST /api/seeding/preview          (xem trước phân bổ)\n     { type, targets, accountCount, actions, reactions }\n  -> { split: [{ targetId, action, count }] }",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b08"
    },
    {
      "id": "text-71-0b9482",
      "type": "text",
      "x": 1000,
      "y": 2105,
      "width": 168,
      "height": 30,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1407057902,
      "version": 2,
      "versionNonce": 431943863,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791592489041,
      "link": null,
      "locked": false,
      "text": "Chạy & Lịch sử",
      "fontSize": 24,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chạy & Lịch sử",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b09"
    },
    {
      "id": "text-72-dd662b",
      "type": "text",
      "x": 1000,
      "y": 2145,
      "width": 683.4,
      "height": 318.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1133611783,
      "version": 3,
      "versionNonce": 1629034890,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791641447005,
      "link": null,
      "locked": false,
      "text": "POST /api/seeding/campaigns              (tạo + bắt đầu)\n     { type, targets: [{ targetId, note }],\n       accountCount, actions, reactions, comments: [],\n       delaySeconds: [30, 60] }\n  -> { campaignId }\nPOST /api/seeding/campaigns/{id}/stop   -> { status: STOPPING }\n\nGET  /api/seeding/campaigns?q&type&status&from&to&page&size\n  -> { stats: { campaigns, interactions, success, failed },\n       items: Row[], total }   (Row = 1 mục tiêu của 1 lần chạy)\nGET  /api/seeding/campaigns/{id}      -> campaign + targets + tasks\nGET  /api/seeding/campaigns/export?... -> file .xlsx\n\nWS   /ws/logs  (có sẵn)  + { campaignId, done, total,\n                             success, failed, message }",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST /api/seeding/campaigns              (tạo + bắt đầu)\n     { type, targets: [{ targetId, note }],\n       accountCount, actions, reactions, comments: [],\n       delaySeconds: [30, 60] }\n  -> { campaignId }\nPOST /api/seeding/campaigns/{id}/stop   -> { status: STOPPING }\n\nGET  /api/seeding/campaigns?q&type&status&from&to&page&size\n  -> { stats: { campaigns, interactions, success, failed },\n       items: Row[], total }   (Row = 1 mục tiêu của 1 lần chạy)\nGET  /api/seeding/campaigns/{id}      -> campaign + targets + tasks\nGET  /api/seeding/campaigns/export?... -> file .xlsx\n\nWS   /ws/logs  (có sẵn)  + { campaignId, done, total,\n                             success, failed, message }",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0A"
    },
