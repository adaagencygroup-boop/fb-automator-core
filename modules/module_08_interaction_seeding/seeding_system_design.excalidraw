    {
      "id": "text-8-ce2c91",
      "type": "text",
      "x": 800,
      "y": 240,
      "width": 550,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 192340715,
      "version": 2,
      "versionNonce": 1741356601,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791592489041,
      "link": null,
      "locked": false,
      "text": "- Mỗi (tài khoản, mục tiêu, hành động) chỉ chạy 1 lần:\n  Follow lần 2 = Bỏ follow, Like lần 2 = Bỏ like.\n- Bền vững & chạy tiếp được: tắt app hoặc engine crash\n  giữa chừng không mất tiến trình, không lặp hành động.\n- Điều khiển nhanh: bấm Dừng có hiệu lực < 2 giây;\n  tiến trình lên giao diện < 1 giây.\n- Tuân thủ giãn cách đã cấu hình giữa 2 lần tương tác.\n- Quy mô nhỏ: vài trăm tài khoản, < ~5k task mỗi\n  chiến dịch, ~5-10 phiên chạy trên 1 máy\n  -> hàng đợi bằng DB là đủ (không cần Redis / Kafka).\n- Một bộ DDL chạy được trên cả Supabase Postgres\n  và SQLite dự phòng.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Mỗi (tài khoản, mục tiêu, hành động) chỉ chạy 1 lần:\n  Follow lần 2 = Bỏ follow, Like lần 2 = Bỏ like.\n- Bền vững & chạy tiếp được: tắt app hoặc engine crash\n  giữa chừng không mất tiến trình, không lặp hành động.\n- Điều khiển nhanh: bấm Dừng có hiệu lực < 2 giây;\n  tiến trình lên giao diện < 1 giây.\n- Tuân thủ giãn cách đã cấu hình giữa 2 lần tương tác.\n- Quy mô nhỏ: vài trăm tài khoản, < ~5k task mỗi\n  chiến dịch, ~5-10 phiên chạy trên 1 máy\n  -> hàng đợi bằng DB là đủ (không cần Redis / Kafka).\n- Một bộ DDL chạy được trên cả Supabase Postgres\n  và SQLite dự phòng.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a8"
    },
