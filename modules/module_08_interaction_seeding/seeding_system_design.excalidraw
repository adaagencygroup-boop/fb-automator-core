    {
      "id": "text-70-6c2473",
      "type": "text",
      "x": 0,
      "y": 2145,
      "width": 622.1999999999999,
      "height": 297.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
