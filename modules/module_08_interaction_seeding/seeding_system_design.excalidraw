      "updated": 1791592489041,
      "link": null,
      "locked": false,
      "text": "4. Tài khoản đang được module khác dùng?",
      "fontSize": 22,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Tài khoản đang được module khác dùng?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1F"
    },
    {
      "id": "text-140-1f2754",
      "type": "text",
      "x": 1940,
      "y": 3895.25,
      "width": 441,
      "height": 202.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g-138-6fa264"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1492159365,
      "version": 2,
      "versionNonce": 697515001,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791592489041,
      "link": null,
      "locked": false,
      "text": "Nuôi nick (M3) và Spam Group (M7) cũng dùng chung\nnick. Đề xuất cho core / Module 2 - cơ chế khoá:\n  accounts.locked_by, accounts.lock_expires_at\n  UPDATE accounts SET locked_by='SEEDING',\n    lock_expires_at = now + 15 phút\n  WHERE uid=? AND (locked_by IS NULL\n    OR lock_expires_at < now)\n- Nhả khoá khi xong; nếu crash thì khoá tự\n  hết hạn.",
      "fontSize": 18,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nuôi nick (M3) và Spam Group (M7) cũng dùng chung\nnick. Đề xuất cho core / Module 2 - cơ chế khoá:\n  accounts.locked_by, accounts.lock_expires_at\n  UPDATE accounts SET locked_by='SEEDING',\n    lock_expires_at = now + 15 phút\n  WHERE uid=? AND (locked_by IS NULL\n    OR lock_expires_at < now)\n- Nhả khoá khi xong; nếu crash thì khoá tự\n  hết hạn.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1G"
    },
