# 9. Build, Packaging & Tauri
# PyInstaller / npm / cargo output (không commit)
build/
dist/
*.egg-info/
*.dist/

# Cargo build cache — rất nặng, mỗi máy tự build
src-tauri/target/

# Schema sinh tự động khi `tauri build` / `tauri dev`
src-tauri/gen/

# Sidecar binary / onedir runtime — build bằng: python scripts/build_sidecar.py
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep
src-tauri/engine-runtime/

# Icon sinh bởi `npx tauri icon` (android/ios/store…) — chỉ giữ 2 file nguồn
src-tauri/icons/**
!src-tauri/icons/icon.png
!src-tauri/icons/icon.ico

# Installer / debug symbols
*.msi
*-setup.exe
*.pdb

# 10. Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
test-results/

# 11. Upload
uploads/

