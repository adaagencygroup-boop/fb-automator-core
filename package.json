{
  "name": "fb-automator-core",
  "version": "2.0.11",
  "description": "Facebook Automator Pro - Enterprise Tauri + PyInstaller Sidecar",
  "scripts": {
    "start": "python start.py",
    "dev": "python start.py",
    "engine:dev": "python engine.py --port 28129",
    "frontend:dev": "npm --prefix frontend run dev",
    "admin:dev": "npm --prefix web-admin run dev",
    "frontend:build": "npm --prefix frontend run build",
    "build:sidecar": "python scripts/build_sidecar.py",
    "build:linux": "python3 scripts/build_sidecar.py && tauri build --config src-tauri/tauri.linux.conf.json",
    "tauri": "tauri",
    "tauri:dev": "npx @tauri-apps/cli dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "npx @tauri-apps/cli build",
    "build:all": "npm run frontend:build && python scripts/build_sidecar.py && npx @tauri-apps/cli build",
    "build:release": "python scripts/build_release.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  }
}
